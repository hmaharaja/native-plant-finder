{
  "name": "native-plant-finder-client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "check:data": "npm run check:data:size && npm run check:data:schema",
    "check:data:size": "node scripts/check-public-data.cjs",
    "check:data:schema": "vitest run --config vitest.config.ts tests/publicData.test.ts",
    "build": "npm run check:data && tsc && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run --config vitest.config.ts",
    "test:e2e": "playwright test -c playwright.config.cjs"
  },
  "dependencies": {
    "react": "18.2.0",
    "react-dom": "18.2.0"
  },
  "devDependencies": {
    "@playwright/test": "1.34.3",
    "@types/node": "18.19.8",
    "@types/react": "18.2.45",
    "@types/react-dom": "18.2.18",
    "@vitejs/plugin-react": "3.1.0",
    "typescript": "5.3.3",
    "vite": "4.5.3",
    "vitest": "0.34.6"
  }
}
